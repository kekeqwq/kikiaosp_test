package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Resource-only OEM presets consumed by the unmodified AOSP ThemePicker.
android_app {
    name: "KikiCustomizationResources",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    sdk_version: "current",
    certificate: "platform",
    system_ext_specific: true,
}
