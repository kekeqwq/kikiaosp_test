# KikiAOSP ADB bring-up: TCP transport for the QEMU user-mode network.
# The USB gadget is not required for this emulator checkpoint.
on boot
    setprop service.adb.tcp.port 5555
    start adbd

# init.usb.rc may stop adbd when the inherited USB config is none. Keep the
# TCP daemon available for the test image.
on property:init.svc.adbd=stopped
    setprop service.adb.tcp.port 5555
    start adbd
