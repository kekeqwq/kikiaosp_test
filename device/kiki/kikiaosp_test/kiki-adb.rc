# KikiAOSP ADB bring-up: TCP transport for the QEMU user-mode network.
# The USB gadget is not required for this emulator checkpoint.
on boot
    setprop service.adb.tcp.port 5555
    start adbd

# init.usb.rc may stop adbd when the inherited USB config is none. Keep the
# TCP daemon available for the test image.
on property:init.svc.adbd=stopped
    setprop service.adb.tcp.port 5555
    start adbd

# APEX adbd is not exposed through the generic USB trigger in this minimal target.
service kiki_adbd /system/apex/com.android.adbd/bin/adbd --root_seclabel=u:r:su:s0
    class core
    socket adbd seqpacket 660 system system
    disabled
    updatable
    seclabel u:r:adbd:s0
    user root

on boot
    start kiki_adbd
on property:init.svc.kiki_adbd=stopped
    start kiki_adbd
