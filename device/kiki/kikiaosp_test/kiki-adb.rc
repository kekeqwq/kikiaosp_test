# KikiAOSP ADB bring-up: non-updatable adbd with init-managed socket.
service kiki_adbd_stage /system/bin/kiki-adb-wait.sh
    class core
    disabled
    oneshot
    seclabel u:r:init:s0
    user root

service kiki_adbd /system/bin/kiki-adbd -a --root_seclabel=u:r:su:s0
    class core
    socket adbd seqpacket 660 system system
    disabled
    seclabel u:r:adbd:s0
    user root

on property:ro.persistent_properties.ready=true
    setprop service.adb.tcp.port 5555
    start kiki_adbd_stage

on property:sys.kiki.aconfig.ready=1
    start kiki_adbd
