# KikiEmu GPT-v1: one user-created disk. boot_part_uuid identifies its device.
/dev/block/by-name/system /system erofs ro wait,first_stage_mount
/dev/block/by-name/vendor /vendor erofs ro wait,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev wait,check,formattable,latemount
/dev/block/by-name/misc /misc emmc defaults wait
