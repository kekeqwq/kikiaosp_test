<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- This sensorless emulator profile intentionally keeps display rotation fixed. -->
    <bool name="config_supportAutoRotation">false</bool>

    <!-- No hardware navigation keys are attached; provide the standard software bar. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Launcher3 Quickstep's widget discovery requires the framework service. -->
    <bool name="config_enableAppWidgetService">true</bool>

    <!--
        The QEMU virtual display supports up to 120 Hz. Keep 60 Hz as the default
        cadence for baseline UI, while allowing up to 120 Hz for apps or the user
        setting that request high-refresh content.
    -->
    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>
</resources>
