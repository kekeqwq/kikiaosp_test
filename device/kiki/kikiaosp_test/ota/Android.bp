package { default_applicable_licenses: ["kiki_ota_license"], }
license { name: "kiki_ota_license", visibility: [":__subpackages__"], license_kinds: ["SPDX-license-identifier-Apache-2.0"], license_text: ["NOTICE"], }
android_app {
    name: "KikiUpdater",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    optimize: { enabled: false },
}
