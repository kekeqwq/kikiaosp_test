        <config><key>CONFIG_ARM64</key><value type="tristate">y</value></config>
        <config><key>CONFIG_ARM64_4K_PAGES</key><value type="tristate">y</value></config>
        <config><key>CONFIG_EROFS_FS</key><value type="tristate">y</value></config>
        <config><key>CONFIG_F2FS_FS</key><value type="tristate">y</value></config>
        <config><key>CONFIG_EXT4_FS</key><value type="tristate">y</value></config>
        <config><key>CONFIG_VIRTIO_BLK</key><value type="tristate">y</value></config>
        <config><key>CONFIG_VIRTIO_PCI</key><value type="tristate">y</value></config>
        <config><key>CONFIG_VIRTIO_NET</key><value type="tristate">y</value></config>
        <config><key>CONFIG_DRM_VIRTIO_GPU</key><value type="tristate">y</value></config>
        <config><key>CONFIG_SND_VIRTIO</key><value type="tristate">y</value></config>
        <config><key>CONFIG_UNIX</key><value type="tristate">y</value></config>
        <config><key>CONFIG_INET</key><value type="tristate">y</value></config>
        <config><key>CONFIG_NETFILTER</key><value type="tristate">y</value></config>
        <config><key>CONFIG_ANDROID_BINDER_IPC</key><value type="tristate">y</value></config>
    </kernel>
</compatibility-matrix>
