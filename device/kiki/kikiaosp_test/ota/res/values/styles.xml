<resources>
    <!-- DeviceDefault.DayNight follows the guest's system theme, including
         dynamic colors. System-bar icon contrast is set from isLightTheme. -->
    <style name="KikiUpdaterTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:enforceStatusBarContrast">true</item>
    </style>
</resources>
