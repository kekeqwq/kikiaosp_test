+        if (mAlsaDeviceProxies.empty()) return ::android::NO_INIT;
+        const size_t bytes = frameCount * mFrameSizeBytes;
+        alsa::applyGain(buffer, mGain, bytes, mConfig.value().format, mConfig->channels);
+        unsigned latency = 0;
+        for (size_t i = 0; i < mAlsaDeviceProxies.size(); ++i) {
+            for (unsigned attempt = 0; ; ++attempt) {
+                const int ret = proxy_write_with_retries(mAlsaDeviceProxies[i].get(), buffer,
+                                                         bytes, mReadWriteRetries);
+                if (ret == 0) break;
+                // Pinned libtinyalsav2 reports ioctl EIO as -1, not -errno.
+                // The existing retry wrapper therefore cannot reinitialize it.
+                // Reopen this PCM before the transient failure poisons the
+                // persistent AIDL stream; never pretend data was consumed.
+                const int error = ret == -1 ? errno : -ret;
+                LOG(WARNING) << __func__ << ": PCM write error=" << error
+                             << " attempt=" << attempt << " detail="
+                             << pcm_get_error(mAlsaDeviceProxies[i].get()->pcm);
+                if (attempt >= 2 || (error != EPIPE && error != EIO &&
+                                     error != EAGAIN && error != ESTRPIPE)) {
+                    return ::android::INVALID_OPERATION;
+                }
+                mAlsaDeviceProxies.clear();
+                if (openDeviceProxies(&mAlsaDeviceProxies) != ::android::OK) {
+                    return ::android::NO_INIT;
+                }
+                LOG(INFO) << __func__ << ": reopened PCM after transient error";
+            }
+            latency = std::max(latency, proxy_get_latency(mAlsaDeviceProxies[i].get()));
+        }
+        *actualFrameCount = frameCount;
+        *latencyMs = std::min(latency,
+                              static_cast<unsigned>(std::numeric_limits<int32_t>::max()));
