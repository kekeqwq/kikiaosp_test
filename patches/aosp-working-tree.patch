+// Gfxstream can expose a valid GLES dispatch table before its host-side
+// renderer has populated the optional string responses. Skia treats a null
+// GL_VERSION as an invalid interface, so provide conservative GLES strings
+// while preserving any real value returned by the guest implementation.
+static const GLubyte* winq_glGetString(GLenum name) {
+    const GLubyte* value = ::glGetString(name);
+    if (value != nullptr) return value;
+    switch (name) {
+        case GL_VENDOR: return reinterpret_cast<const GLubyte*>("KikiAOSP Gfxstream");
+        case GL_RENDERER: return reinterpret_cast<const GLubyte*>("KikiAOSP GLES renderer");
+        case GL_VERSION: return reinterpret_cast<const GLubyte*>("OpenGL ES 3.0 KikiAOSP");
+        case GL_EXTENSIONS: return reinterpret_cast<const GLubyte*>("");
+        default: return nullptr;
+    }
+}
+
