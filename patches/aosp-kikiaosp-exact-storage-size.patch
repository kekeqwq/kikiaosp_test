@@ -1394,15 +1394,35 @@ public class StorageManager {
 
     /** @hide */
     public static Pair<String, Long> getPrimaryStoragePathAndSize() {
+        return Pair.create(null, getPrimaryStorageSizeBytes());
+    }
+
+    private static long getPrimaryStorageSizeBytes() {
+        if (SystemProperties.getBoolean("ro.kikiaosp.exact_storage_size", false)) {
+            // KikiEmu disks have arbitrary immutable capacities, not phone
+            // marketing tiers. Vold follows /data to its parent block disk.
+            final IStorageManager storage = IStorageManager.Stub.asInterface(
+                    ServiceManager.getService("mount"));
+            if (storage == null) {
+                throw new IllegalStateException("Storage service is not ready");
+            }
+            try {
+                final long bytes = storage.getInternalStorageBlockDeviceSize();
+                if (bytes <= 0 || bytes < Environment.getDataDirectory().getTotalSpace()) {
+                    throw new IllegalStateException("Invalid internal block device capacity");
+                }
+                return bytes;
+            } catch (RemoteException e) {
+                throw e.rethrowFromSystemServer();
+            }
+        }
-        return Pair.create(null,
-                FileUtils.roundStorageSize(Environment.getDataDirectory().getTotalSpace()
-                        + Environment.getRootDirectory().getTotalSpace()));
+        return FileUtils.roundStorageSize(Environment.getDataDirectory().getTotalSpace()
+                + Environment.getRootDirectory().getTotalSpace());
     }
 
     /** @hide */
     public long getPrimaryStorageSize() {
-        return FileUtils.roundStorageSize(Environment.getDataDirectory().getTotalSpace()
-                + Environment.getRootDirectory().getTotalSpace());
+        return getPrimaryStorageSizeBytes();
     }
 
