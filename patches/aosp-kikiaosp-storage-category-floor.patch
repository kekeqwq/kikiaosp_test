+    @VisibleForTesting
+    static long calculateTemporaryFilesSize(long usedBytes, long attributedBytes, boolean exact) {
+        // The KikiEmu disk and categories must reconcile to actual bytes;
+        // do not invent an additional 1 GiB of temporary files. Other products
+        // retain the upstream minimum and the shared asynchronous-stat guard.
+        final long minimum = exact ? 0 : DataUnit.GIBIBYTES.toBytes(1);
+        return Math.max(minimum, usedBytes - attributedBytes);
+    }
