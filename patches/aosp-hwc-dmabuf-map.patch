+class ScopedDmaBufMapping {
+   public:
+    ~ScopedDmaBufMapping() { Finish(); }
+
+    bool Map(int fd, size_t size) {
+        if (fd < 0 || size == 0) {
+            ALOGE("%s: invalid dma-buf fd:%d size:%zu", __FUNCTION__, fd, size);
+            return false;
+        }
+
+        mFd = fd;
+        mSize = size;
+
+        struct dma_buf_sync sync = {};
+        sync.flags = static_cast<decltype(sync.flags)>(DMA_BUF_SYNC_START | DMA_BUF_SYNC_RW);
+        if (ioctl(mFd, DMA_BUF_IOCTL_SYNC, &sync) == 0) {
+            mSyncStarted = true;
+        } else {
+            ALOGW("%s: dma-buf CPU sync start failed: %s; trying mmap", __FUNCTION__,
+                  strerror(errno));
+        }
+
+        mData = mmap(nullptr, mSize, PROT_READ | PROT_WRITE, MAP_SHARED, mFd, 0);
+        if (mData == MAP_FAILED) {
+            const int error = errno;
+            mData = nullptr;
+            Finish();
+            ALOGE("%s: dma-buf mmap failed: %s", __FUNCTION__, strerror(error));
+            return false;
+        }
+        return true;
+    }
+
+    uint8_t* Get() const { return static_cast<uint8_t*>(mData); }
+
+    void Finish() {
+        if (mSyncStarted) {
+            struct dma_buf_sync sync = {};
+            sync.flags = static_cast<decltype(sync.flags)>(DMA_BUF_SYNC_END | DMA_BUF_SYNC_RW);
+            if (ioctl(mFd, DMA_BUF_IOCTL_SYNC, &sync) != 0) {
+                ALOGW("%s: dma-buf CPU sync end failed: %s", __FUNCTION__, strerror(errno));
+            }
+            mSyncStarted = false;
+        }
+        if (mData != nullptr) {
+            munmap(mData, mSize);
+            mData = nullptr;
+        }
+        mSize = 0;
+        mFd = -1;
+    }
+
+   private:
+    int mFd = -1;
+    size_t mSize = 0;
+    void* mData = nullptr;
+    bool mSyncStarted = false;
+};
